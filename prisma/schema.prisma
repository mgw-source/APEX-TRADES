generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String
  role             String           @default("USER")
  resetTokenHash   String?
  resetExpiresAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  subscriptions    Subscription[]
  courseProgress   CourseProgress[]
  copyConnections  CopyConnection[]
  botActivations   BotActivation[]
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String   @default("ACTIVE")
  interval              String   @default("MONTHLY")
  stripeCustomerId      String?
  stripeSubscriptionId  String?  @unique
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, status])
}

model Bot {
  id          String   @id @default(cuid())
  name        String
  symbol      String
  strategy    String
  description String
  returnRate  String   @default("0.0%")
  winRate     String   @default("0.0%")
  tradeCount  Int      @default(0)
  downloadUrl String?
  active      Boolean  @default(true)
  activations BotActivation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String           @id @default(cuid())
  title       String
  module      String
  description String
  lessonCount Int              @default(0)
  sortOrder   Int              @default(0)
  assetUrl    String?
  progress    CourseProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CourseProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model Trade {
  id        String   @id @default(cuid())
  symbol    String
  side      String
  entry     Float
  exit      Float?
  result    String?
  notes     String?
  status    String   @default("OPEN")
  openedAt  DateTime @default(now())
  closedAt  DateTime?
  createdAt DateTime @default(now())
}

model CopyConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  accountName String
  connected   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider, accountName])
}

model BotActivation {
  id        String   @id @default(cuid())
  userId    String
  botId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, botId])
}